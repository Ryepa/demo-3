# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather, e.g. 123456789:AA...
BOT_TOKEN=
# Chat (or group/channel) that receives leads, e.g. 123456789 or -1001234567890
CHAT_ID=

# true = log leads to the console instead of sending them (no bot needed)
DEMO_MODE=true

# Rate limit: at most RATE_LIMIT_MAX leads per IP per RATE_LIMIT_WINDOW seconds
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# Read the client IP from X-Forwarded-For (keep true behind Railway/Render proxies)
TRUST_PROXY=true
